/* --- Estilos Generales --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f4f7f6;
    color: #333;
    line-height: 1.6;
}

/* --- Encabezado / Header --- */
.encabezado {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: white;
    text-align: center;
    padding: 3rem 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.encabezado h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.encabezado p {
    font-size: 1.1rem;
    opacity: 0.9;
}

/* --- Contenedor Principal --- */
.contenedor {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
}

/* --- Tarjetas / Secciones --- */
.tarjeta {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 2rem;
    flex: 1 1 300px; /* Hace que se adapte a móviles y computadoras */
    max-width: 350px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
}

.tarjeta:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

.icono {
    font-size: 2.5rem;
    color: #4f46e5;
    margin-bottom: 1rem;
}

.tarjeta h2 {
    color: #1f2937;
    font-size: 1.5rem;
    margin-bottom: 0.8rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
}

.tarjeta p {
    color: #4b5563;
    font-size: 0.95rem;
    text-align: justify;
}

/* --- Pie de página / Footer --- */
footer {
    text-align: center;
    padding: 1.5rem;
    background-color: #1e293b;
    color: #94a3b8;
    margin-top: 3rem;
    font-size: 0.9rem;
}
.imagen-tarjeta {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
}